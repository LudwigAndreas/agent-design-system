{
  "name": "onecheck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A design system whose UI can be operated by both humans and an AI agent through the same application state.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
